# 正式部署时必须改为真实域名；此值仅作为公开示例。
NEXT_PUBLIC_SITE_URL=https://example.com

# SIGNAL HUNT（抽奖系统）站点根地址，代码自动拼接 /display 与 /admin/dashboard。
# 开发环境可指向本机开发服务器，例如：http://127.0.0.1:5180
# 生产构建必须配置正式域名；未配置时「在线体验」与「管理后台」入口自动隐藏。
# 重要：此变量必须写入 .env.local 或部署环境的持久化配置，不能只设为临时会话变量，
# 否则下一次部署构建时入口会消失。生产环境正式值：
# NEXT_PUBLIC_SIGNAL_HUNT_URL=https://lottery.berl1n.xyz

# Diamond Track Atlas（钻石田径图鉴）站点根地址，入口直接指向该地址首页。
# 开发环境可指向本机开发服务器，例如：http://127.0.0.1:5173
# 生产构建必须配置正式域名；未配置时「在线体验」入口自动隐藏。
# 同样必须写入 .env.local 或部署环境的持久化配置，不能只设为临时会话变量。
# 生产环境正式值：
# NEXT_PUBLIC_STDM_URL=https://stdm.berl1n.xyz

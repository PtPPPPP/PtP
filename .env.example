# 正式部署时必须改为真实域名；此值仅作为公开示例。
NEXT_PUBLIC_SITE_URL=https://example.com

# SIGNAL HUNT（抽奖系统）站点根地址，代码自动拼接 /display 与 /admin/dashboard。
# 代码内已内置正式域名兜底（https://lottery.berl1n.xyz），未配置时入口依然可见；
# 此变量仅用于开发环境指向本机开发服务器（例如 http://127.0.0.1:5180），
# 生产构建配置本机地址会直接报错。
# NEXT_PUBLIC_SIGNAL_HUNT_URL=https://lottery.berl1n.xyz

# Diamond Track Atlas（钻石田径图鉴）站点根地址，入口直接指向该地址首页。
# 与 SIGNAL HUNT 相同：代码内已内置正式域名兜底（https://stdm.berl1n.xyz），
# 此变量仅用于开发环境覆盖（例如 http://127.0.0.1:5173）。
# NEXT_PUBLIC_STDM_URL=https://stdm.berl1n.xyz
